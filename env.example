# Copy to a private file outside the repository, then point systemd at it.
# Never commit real hosts, Tailscale IPs, tokens, VAPID private keys, or subscriptions.

RENDER_STATUS_PORT=8765
RENDER_STATUS_WINDOWS_SSH=YOUR_WINDOWS_USER@YOUR_TAILSCALE_IP
RENDER_STATUS_WINDOWS_RENDER_DIR=E:\\path\\to\\your\\render\\frames
RENDER_STATUS_WINDOWS_TASK=YourWindowsScheduledTaskName
RENDER_STATUS_WINDOWS_LABEL=25% Viskosität · Render
RENDER_STATUS_VAPID_SUBJECT=mailto:you@example.com
